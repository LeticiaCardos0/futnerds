{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projeto-futnerds-ng",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/projeto-futnerds-ng/browser",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}